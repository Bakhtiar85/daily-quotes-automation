# Environment Configuration for Daily Quotes Traffic Simulator
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, production, staging)
NODE_ENV=development

# Number of concurrent users to simulate
CONCURRENT_USERS=5

# Target website URL (your deployed quotes site)
TARGET_URL=https://daily-quotes-blond.vercel.app/

# =============================================================================
# BROWSER SETTINGS
# =============================================================================

# Run browsers in headless mode (true/false)
# Set to false to see browsers in action (useful for debugging)
HEADLESS=true

# Browser timeout (milliseconds)
BROWSER_TIMEOUT=30000

# =============================================================================
# BEHAVIOR SETTINGS
# =============================================================================

# Minimum scroll depth percentage (0-100)
MIN_SCROLL_DEPTH=40

# Maximum scroll depth percentage (0-100)
MAX_SCROLL_DEPTH=90

# Minimum time on page (seconds)
MIN_TIME_ON_PAGE=10

# Maximum time on page (seconds)
MAX_TIME_ON_PAGE=45

# Probability to click random quote (0.0 - 1.0)
CLICK_RANDOM_QUOTE_PROBABILITY=0.7

# Probability to read story (0.0 - 1.0)
READ_STORY_PROBABILITY=0.6

# Visit multiple pages (true/false)
VISIT_MULTIPLE_PAGES=true

# Maximum number of additional pages to visit
MAX_PAGES_TO_VISIT=2

# =============================================================================
# FILE PATHS
# =============================================================================

# Path to proxies configuration
PROXY_CONFIG_PATH=./config/proxies.json

# Path to users configuration
USER_CONFIG_PATH=./config/users.json

# Path to devices configuration
DEVICE_CONFIG_PATH=./config/devices.json

# Log directory
LOG_DIRECTORY=./logs

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Maximum log file size (bytes) - 5MB default
LOG_MAX_SIZE=5242880

# Maximum number of log files to keep
LOG_MAX_FILES=5

# =============================================================================
# PROXY SETTINGS (OPTIONAL)
# =============================================================================

# Default proxy timeout (milliseconds)
PROXY_TIMEOUT=10000

# Retry failed proxy connections (true/false)
RETRY_PROXY_FAILURES=true

# Maximum proxy retry attempts
MAX_PROXY_RETRIES=3

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Delay between launching concurrent sessions (milliseconds)
SESSION_LAUNCH_DELAY=1000

# Memory limit per browser instance (MB)
BROWSER_MEMORY_LIMIT=512

# Enable detailed performance metrics (true/false)
ENABLE_PERFORMANCE_METRICS=true

# Random delay between batches (in minutes)
MIN_DELAY_BETWEEN_BATCHES=3
MAX_DELAY_BETWEEN_BATCHES=10

# Continuous mode settings
MIN_ACTIVE_USERS=3          # Minimum concurrent users during off-peak
MAX_ACTIVE_USERS=8          # Maximum concurrent users during peak hours
PEAK_HOURS_START=9          # Peak traffic start (24h format)
PEAK_HOURS_END=21           # Peak traffic end (24h format)
SESSION_START_DELAY=10      # Seconds between starting new sessions

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Never commit .env file to git (it's in .gitignore)
# 2. Update TARGET_URL with your actual deployed website
# 3. Adjust CONCURRENT_USERS based on your proxy count
# 4. Set HEADLESS=false for debugging (to see browser actions)
# 5. Increase timeouts if your website is slow to load
#